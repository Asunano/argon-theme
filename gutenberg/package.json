{
	"name": "argon-gutenberg-blocks",
	"version": "1.0.0",
	"private": true,
	"description": "Argon 主题的古腾堡区块（alert / admonition / collapse / github / progressbar / tabpanel / timeline / todolist）",
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=src --output-path=dist",
		"start": "wp-scripts start --webpack-src-dir=src --output-path=dist",
		"format": "wp-scripts format src",
		"lint:js": "wp-scripts lint-js src"
	},
	"dependencies": {
		"is-whitespace-character": "^2.0.0"
	},
	"devDependencies": {
		"@wordpress/scripts": "36.0.0"
	}
}
